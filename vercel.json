{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "src/db/migrations/**",
      "maxDuration": 60,
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/fx",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:webp|png|jpg|jpeg|gif|svg|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/(.*\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guides/100k-salary-new-york",
      "destination": "https://www.livworthy.com/guides/nyc-100k",
      "permanent": true
    },
    {
      "source": "/guides/100k-salary-new-york/",
      "destination": "https://www.livworthy.com/guides/nyc-100k",
      "permanent": true
    },
    {
      "source": "/guides/london-60k",
      "destination": "https://www.livworthy.com/guides/london-75k",
      "permanent": true
    },
    {
      "source": "/guides/london-60k/",
      "destination": "https://www.livworthy.com/guides/london-75k",
      "permanent": true
    },
    {
      "source": "/guides/toronto-90k",
      "destination": "https://www.livworthy.com/guides/toronto-100k",
      "permanent": true
    },
    {
      "source": "/guides/toronto-90k/",
      "destination": "https://www.livworthy.com/guides/toronto-100k",
      "permanent": true
    },
    {
      "source": "/guides/dubai-30k",
      "destination": "https://www.livworthy.com/guides/dubai-300k",
      "permanent": true
    },
    {
      "source": "/guides/dubai-30k/",
      "destination": "https://www.livworthy.com/guides/dubai-300k",
      "permanent": true
    },
    {
      "source": "/guides/singapore-10k",
      "destination": "https://www.livworthy.com/guides/singapore-120k",
      "permanent": true
    },
    {
      "source": "/guides/singapore-10k/",
      "destination": "https://www.livworthy.com/guides/singapore-120k",
      "permanent": true
    },
    {
      "source": "/guides/berlin-65k",
      "destination": "https://www.livworthy.com/guides/berlin-80k",
      "permanent": true
    },
    {
      "source": "/guides/berlin-65k/",
      "destination": "https://www.livworthy.com/guides/berlin-80k",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "livworthy.com"
        }
      ],
      "destination": "https://www.livworthy.com/",
      "permanent": true
    },
    {
      "source": "/(.*)/",
      "has": [
        {
          "type": "host",
          "value": "livworthy.com"
        }
      ],
      "destination": "https://www.livworthy.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "livworthy.com"
        }
      ],
      "destination": "https://www.livworthy.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
