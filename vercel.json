{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|favicon|logo|icon|manifest|robots\\.txt|sitemap|ads\\.txt|llms\\.txt|about|methodology|sources|editorial-policy|data-policy|corrections|terms|privacy|countries|cities|compare|guides).*)",
      "destination": "/index.html"
    }
  ]
}
